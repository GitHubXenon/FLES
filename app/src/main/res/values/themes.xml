<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        浅色主题。只用 Android 系统自带主题，不依赖 AppCompat / Material 库。
        深色模式时系统会自动改用 values-night/themes.xml 里的同名主题。
    -->
    <style name="Theme.FLES" parent="android:Theme.Material.Light.NoActionBar">
        <!-- 单选按钮、对话框按钮等的强调色，与 App 主色一致 -->
        <item name="android:colorAccent">@color/fles_primary</item>
        <!-- 冷启动时窗口先显示的背景色，避免深色模式下闪一下白屏 -->
        <item name="android:windowBackground">@color/fles_bg</item>
        <!-- 我们自己提供深色配色，不需要系统“强制深色”再反色一次 -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
