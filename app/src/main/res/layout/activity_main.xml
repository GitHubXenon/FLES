<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F6FA">

    <!-- ============================================================= -->
    <!-- 首页                                                         -->
    <!-- ============================================================= -->
    <ScrollView
        android:id="@+id/pageHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/txtHomeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FLES"
                android:textColor="#172033"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHomeSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Foreign Language Example Sentence"
                android:textColor="#687386"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtLanguagePair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#E9EDF5"
                android:padding="13dp"
                android:text="母语：中文    学习语言：日语"
                android:textColor="#263248"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnStartStudy"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#315FCE"
                android:text="开始学习"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLearningModeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="学习方向"
                android:textColor="#263248"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgLearningMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp">

                <RadioButton
                    android:id="@+id/radioMixed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="44dp"
                    android:text="双向混合（随机切换）"
                    android:textColor="#263248"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/radioForeignToNative"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="显示外语，回忆母语"
                    android:textColor="#263248"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/radioNativeToForeign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="显示母语，回忆外语"
                    android:textColor="#263248"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/txtMySentenceLibraryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="我的句子库"
                android:textColor="#263248"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMasteryLibrary"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#DCEFE5"
                    android:text="熟练库 (0)"
                    android:textAllCaps="false"
                    android:textColor="#185C3A"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnFavoriteLibrary"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E5EAFB"
                    android:text="收藏库 (0)"
                    android:textAllCaps="false"
                    android:textColor="#294B9A"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtActiveCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="当前题库：0 条"
                android:textColor="#687386"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:background="#DDE2EA" />

            <TextView
                android:id="@+id/txtQuestionFileLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="题库文件"
                android:textColor="#263248"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:text="尚未选择题库文件夹"
                android:textColor="#687386"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnChooseFolder"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E3E7EF"
                android:text="选择 / 更换题库文件夹"
                android:textAllCaps="false"
                android:textColor="#263248"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnLanguageSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E3E7EF"
                android:text="语言设置"
                android:textAllCaps="false"
                android:textColor="#263248"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ============================================================= -->
    <!-- 学习卡片页                                                    -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/pageStudy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExitStudy"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="#E3E7EF"
                android:minWidth="88dp"
                android:text="退出学习"
                android:textAllCaps="false"
                android:textColor="#263248"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtStudyPageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:text="学习中"
                android:textColor="#687386"
                android:textSize="14sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollStudyContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingTop="18dp"
                android:paddingEnd="6dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/txtStudySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="板块：日常生活"
                    android:textColor="#788397"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtPromptDirection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="请回忆母语意思"
                    android:textColor="#315FCE"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPromptText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:minHeight="150dp"
                    android:padding="22dp"
                    android:text="ご飯を食べてから学校へ行きます。"
                    android:textColor="#172033"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnShowAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#315FCE"
                    android:text="显示答案"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#E9F0FF"
                    android:padding="17dp"
                    android:text="吃完饭后去学校。"
                    android:textColor="#203B78"
                    android:textSize="19sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMemoryHint"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E3E7EF"
                        android:text="记忆提示"
                        android:textAllCaps="false"
                        android:textColor="#263248"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnPronunciationGuide"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E3E7EF"
                        android:text="全句注音"
                        android:textAllCaps="false"
                        android:textColor="#263248"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtMemoryHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#FFF5DD"
                    android:padding="14dp"
                    android:text="记忆提示内容"
                    android:textColor="#684B12"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtPronunciationGuide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#E5F4ED"
                    android:padding="14dp"
                    android:text="全句注音内容"
                    android:textColor="#185C3A"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/txtNoLearningSentences"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:text="目前没有可学习的句子。请返回首页检查题库，或明天继续。"
            android:textColor="#687386"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMarkMastered"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#DCEFE5"
                android:text="熟悉"
                android:textAllCaps="false"
                android:textColor="#185C3A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleFavorite"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#E5EAFB"
                android:text="收藏"
                android:textAllCaps="false"
                android:textColor="#294B9A"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnNextCard"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#315FCE"
                android:text="下一题"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================= -->
    <!-- 熟练库 / 收藏库共用页面                                      -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/pageLibrary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLibraryBack"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="#E3E7EF"
                android:minWidth="76dp"
                android:text="返回"
                android:textAllCaps="false"
                android:textColor="#263248"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtLibraryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="熟练库"
                android:textColor="#172033"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLibraryRefresh"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="#E3E7EF"
                android:minWidth="70dp"
                android:text="刷新"
                android:textAllCaps="false"
                android:textColor="#263248"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtLibraryEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:text="这里还没有句子。"
            android:textColor="#687386"
            android:textSize="15sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/listSentences"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="#DDE2EA"
            android:dividerHeight="1dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

</FrameLayout>
